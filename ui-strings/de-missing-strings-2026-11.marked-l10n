# EN: Display header link icons
# DRAFT: Link-Symbole an Überschriften anzeigen

"tooltip.showHeaderLinkIcons" = "Zeigt beim Überfahren mit dem Mauszeiger ein Link-Symbol neben Überschriften an. Klicken Sie darauf, um einen Marked-Deep-Link zu dieser Überschrift zu kopieren.";
# EN: Show a link icon next to headings on hover. Click to copy a Marked deep link to that heading.
# DRAFT: Zeigt beim Überfahren mit dem Mauszeiger ein Link-Symbol neben Überschriften an. Klicken Sie darauf, um einen Marked-Deep-Link zu dieser Überschrift zu kopieren.

