# Marked Settings Localization Patch
# Locale: fr (French)
# Generated: 2026-08-13
# Feature: Scrivener Assume Markdown + Automatic returns
#
# HOW TO TRANSLATE
# ----------------
# Review or revise the DRAFT translations below.
# Fill/edit the string on each line: "key" = "your translation";
# Keep keys unchanged.
# Preserve %@, %ld, %1$@, %2$ld, \n, and keyboard symbols.
# Do not translate product names (Marked, Scrivener, Markdown, MultiMarkdown)
# unless your locale normally localizes them.
#
# DRAFT lines are starting translations applied to Settings.strings;
# please correct tone/terminology to match your locale UI glossary.
#
# Return this file with translations finalized (same filename).
# We merge with: python3 scripts/merge_localization_updates.py <this-file>
#
# CONTEXT
# -------
# Applications → Scrivener settings:
# 1) Checkbox: "Assume Markdown formatting" (default ON)
# 2) Popup: "Treat Scrivener returns as" with options:
#    Automatic (default) | Soft line breaks (join lines) | Paragraph breaks (keep separate)
# Automatic follows the checkbox: ON → soft join; OFF → keep separate paragraphs.
# The tooltip mentions the existing "Retain line breaks in paragraphs"
# preference (githubNewlines); use that setting's localized title in your locale.
# Pipe tables and fenced code blocks must remain unaffected by the returns option.
#
# This replaces the older *-scrivener-linebreaks.marked-l10n handoff
# (popup labels and tooltip were renamed / expanded).
#
# SUMMARY
# -------
#   Settings.strings keys: 7

=== BEGIN Settings.strings (gaps) ===
# Strings in this section: 7

"setting.scrivenerAssumeMarkdown" = "Supposer le formatage Markdown";
# EN: Assume Markdown formatting
# DRAFT: Supposer le formatage Markdown

"tooltip.scrivenerAssumeMarkdown" = "Traitez les documents de reliure comme Markdown rédigés en Scrivener (listes dactylographiées, tableaux, clôtures, lignes vides entre les paragraphes) plutôt que comme une structure de texte riche Scrivener seule.";
# EN: Treat binder documents as Markdown authored in Scrivener (typed lists, tables, fences, blank lines between paragraphs) rather than Scrivener rich-text structure alone.
# DRAFT: Traitez les documents de reliure comme Markdown rédigés en Scrivener (listes dactylographiées, tableaux, clôtures, lignes vides entre les paragraphes) plutôt que comme une structure de texte riche Scrivener seule.

"setting.scrivenerLineBreaks" = "Traiter les retours Scrivener comme";
# EN: Treat Scrivener returns as
# DRAFT: Traiter les retours Scrivener comme

"setting.scrivenerLineBreaks.automatic" = "Automatique";
# EN: Automatic
# DRAFT: Automatique

"setting.scrivenerLineBreaks.lineBreaks" = "Sauts de ligne souples (joindre les lignes)";
# EN: Soft line breaks (join lines)
# DRAFT: Sauts de ligne souples (joindre les lignes)

"setting.scrivenerLineBreaks.paragraphs" = "Sauts de paragraphe (garder séparés)";
# EN: Paragraph breaks (keep separate)
# DRAFT: Sauts de paragraphe (garder séparés)

"tooltip.scrivenerLineBreaks" = "Comment interpréter Return dans Scrivener lors de la conversion en Markdown. Suivi automatique Supposons le formatage Markdown : sauts de ligne souples lorsque Markdown est supposé, sauts de paragraphe lorsqu'il ne l'est pas. Les sauts de ligne progressifs (lignes de jointure) fusionnent les retours consécutifs en sauts de ligne progressifs à l'intérieur d'un paragraphe (une ligne vide commence un nouveau paragraphe ; sous réserve de conserver les sauts de ligne dans les paragraphes). Les sauts de paragraphe (à garder séparés) conservent chaque retour sous la forme d'un paragraphe Markdown. Les tables de canalisations et les blocs de code clôturés ne sont pas affectés.";
# EN: How to interpret Return in Scrivener when converting to Markdown. Automatic follows Assume Markdown formatting: soft line breaks when Markdown is assumed, paragraph breaks when it is not. Soft line breaks (join lines) merge consecutive Returns into soft breaks inside a paragraph (a blank line starts a new paragraph; subject to Retain line breaks in paragraphs). Pipe tables and fenced code blocks are unaffected.
# DRAFT: Comment interpréter Return dans Scrivener lors de la conversion en Markdown. Suivi automatique Supposons le formatage Markdown : sauts de ligne souples lorsque Markdown est supposé, sauts de paragraphe lorsqu'il ne l'est pas. Les sauts de ligne progressifs (lignes de jointure) fusionnent les retours consécutifs en sauts de ligne progressifs à l'intérieur d'un paragraphe (une ligne vide commence un nouveau paragraphe ; sous réserve de conserver les sauts de ligne dans les paragraphes). Les sauts de paragraphe (à garder séparés) conservent chaque retour sous la forme d'un paragraphe Markdown. Les tables de canalisations et les blocs de code clôturés ne sont pas affectés.

=== END Settings.strings (gaps) ===
