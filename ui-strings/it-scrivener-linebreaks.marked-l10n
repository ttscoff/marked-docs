"setting.scrivenerLineBreaks" = "Tratta le interruzioni di riga singole come";
# EN: Treat single line breaks as
# DRAFT: Tratta le interruzioni di riga singole come

"setting.scrivenerLineBreaks.lineBreaks" = "Interruzioni di riga";
