# Marked Localization Update
# Locale: zh-Hant (Chinese (Traditional))
# Feature: Command-number Tab Selection and Style Shortcuts
# Generated: 2026-11-26
#
# HOW TO TRANSLATE
# ----------------
# Fill in or correct the string on each line: "key" = "your translation";
# Keep keys unchanged. Preserve format specifiers (%ld) and shortcut glyphs unchanged.
# Do not translate product names (Marked, macOS).
#
# CONTEXT
# -------
# General settings adds a checkbox to choose whether Command-1..9 select styles
# (default) or switch tabs (Command-1..8 for tabs 1-8, Command-9 for the last tab).
# Window > Select Tab lists the tab shortcuts. Style Manager legend drops Shift-Command
# and updates to reflect whether Command-number selects styles or tabs.
#
# Return this file with translations filled in (same filename).
# Merge with: python3 scripts/merge_localization_updates.py <this-file>

=== BEGIN Settings.strings ===
"setting.useCommandNumberForStyles" = "使用 ⌘1–⌘9 選擇樣式";
# EN: Use ⌘1–⌘9 to select styles
# DRAFT: 使用 ⌘1–⌘9 選擇樣式

"tooltip.useCommandNumberForStyles" = "勾選時，⌘1 至 ⌘9 用於選擇樣式。取消勾選後，⌘1 至 ⌘8 會切換至對應分頁，⌘9 會跳至最後一個分頁；樣式快速鍵則改由 ⌥⌘1 開始（⌥⌘1–0，接著是 ⌃⌘1–0）。當新文件開啟方式設為獨立視窗時，此選項無效。";
# EN: When checked, ⌘1 through ⌘9 select styles. Uncheck to use ⌘1 through ⌘8 to switch to that tab and ⌘9 to jump to the last tab; style shortcuts then start at ⌥⌘1 (⌥⌘1–0, then ⌃⌘1–0). Has no effect when "New documents open in" is set to Separate windows.
# DRAFT: 勾選時，⌘1 至 ⌘9 用於選擇樣式。取消勾選後，⌘1 至 ⌘8 會切換至對應分頁，⌘9 會跳至最後一個分頁；樣式快速鍵則改由 ⌥⌘1 開始（⌥⌘1–0，接著是 ⌃⌘1–0）。當新文件開啟方式設為獨立視窗時，此選項無效。

=== END Settings.strings ===

