"setting.convertPlusPageBreaks" = "將 +++ 視為分頁符";
# EN: Treat +++ as page breaks
# DRAFT: 將 +++ 視為分頁符

"tooltip.convertPlusPageBreaks" = "啟用後，一行三個或更多 + 字元將被視為分頁符號（與 <!--BREAK--> 相同）。與 iA Writer 相容。預設關閉。";
